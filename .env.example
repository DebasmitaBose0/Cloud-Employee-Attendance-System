# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection URI
# Local Windows / Ubuntu Community Edition:
# MONGO_URI="mongodb://127.0.0.1:27017/attendance_system"
# Leave blank in sandboxed dev to auto-launch an in-process MongoMemoryServer instance.
MONGO_URI=""

# Authentication & Security
JWT_SECRET="replace-with-a-strong-random-64-char-secret"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origin (comma-separated for multiple origins)
CLIENT_URL="http://localhost:3000"

# Initial Administrator Seed Credentials (change password after first login)
ADMIN_NAME="Claire Vance"
ADMIN_EMAIL="admin@attendcloud.local"
ADMIN_PASSWORD="Admin@ChangeMe2026"
DEFAULT_EMPLOYEE_PASSWORD="Employee@2026"

# Working Calendar Configuration (0=Sun, 6=Sat)
WEEKEND_DAYS="0,6"
PUBLIC_HOLIDAYS="2026-01-01,2026-01-26,2026-05-01,2026-07-04,2026-08-15,2026-10-02,2026-11-26,2026-12-25"
